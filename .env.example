# ============================================================
# Shaheer Gaming Store - Required Environment Variables
# ============================================================
# Copy this file to `.env` for local development.
# For Vercel: add these variables in Project Settings -> Environment Variables.
# Do NOT commit real secrets/passwords/keys.

# ------------------------------------------------------------
# DJANGO / BACKEND
# ------------------------------------------------------------

# Django secret key.  MUST be set in production to a long random
# string (e.g. `python -c "import secrets; print(secrets.token_urlsafe(64))"`).
# Fallback (dev-only insecure default) is hard-coded in settings.py;
# production will still boot but you SHOULD override this.
DJANGO_SECRET_KEY=

# "True" for local dev, "False" for production/Vercel.
DJANGO_DEBUG=True

# Comma-separated list of hostnames Django will serve.
# Vercel auto-sets VERCEL_URL which is appended automatically,
# so this is usually only needed for custom domains.
# Example: example.com,api.example.com,www.example.com
DJANGO_ALLOWED_HOSTS=

# If Django is being served under a URL prefix (rare on Vercel),
# set the prefix here (e.g. "/django"). Leave empty otherwise.
DJANGO_FORCE_SCRIPT_NAME=

# ------------------------------------------------------------
# FRONTEND / VITE
# ------------------------------------------------------------

# Absolute URL (including /api suffix) of the Django backend.
# Only needed for local dev when frontend and backend run on
# different ports (e.g. Vite on :5173, Django on :8000).
# On Vercel this auto-falls back to same-origin "/api" and
# does NOT need to be set.
VITE_API_URL=http://127.0.0.1:8000/api
